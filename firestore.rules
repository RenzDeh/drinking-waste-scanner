rules_version = '2';

// Statiegeld-scanner: GEEN authenticatie.
// - Iedereen mag scans lezen (nodig voor profiel + leaderboard).
// - Iedereen mag een scan AANMAKEN, maar enkel met exact de verwachte velden en geldige waarden.
// - Updaten en verwijderen is nooit toegestaan.
// - Alle andere collecties zijn dicht.
// Hou de punten en de zekerheidsdrempel (0.9) in sync met src/config.js
// (POINTS, TRIGGER.confidenceThreshold en DAILY_CHALLENGES.bonus).

service cloud.firestore {
  match /databases/{database}/documents {

    function validScan(d) {
      return d.keys().hasOnly(['spelerId', 'bijnaam', 'klasse', 'punten', 'zekerheid', 'tijdstip'])
        && d.keys().hasAll(['spelerId', 'bijnaam', 'klasse', 'punten', 'zekerheid', 'tijdstip'])
        // speler-ID: UUID of hex-string, geen willekeurige tekst
        && d.spelerId is string
        && d.spelerId.matches('^[A-Za-z0-9-]{16,64}$')
        // bijnaam: 2-20 tekens, geen HTML-haakjes
        && d.bijnaam is string
        && d.bijnaam.size() >= 2 && d.bijnaam.size() <= 20
        && !d.bijnaam.matches('.*[<>].*')
        // tijdstip moet de servertijd zijn (serverTimestamp()), niet door de client gekozen
        && d.tijdstip == request.time
        && d.punten is int
        && d.zekerheid is number
        && validPoints(d);
    }

    function validPoints(d) {
      return (d.klasse == 'blik' && d.punten == 10 && d.zekerheid > 0.9 && d.zekerheid <= 1)
          || (d.klasse == 'pet'  && d.punten == 10 && d.zekerheid > 0.9 && d.zekerheid <= 1)
          || (d.klasse == 'glas' && d.punten == 5  && d.zekerheid > 0.9 && d.zekerheid <= 1)
          // bonus van het dagdoel
          || (d.klasse == 'bonus' && d.punten >= 1 && d.punten <= 50 && d.zekerheid == 1);
    }

    match /scans/{scanId} {
      allow read: if true;
      allow create: if validScan(request.resource.data);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
