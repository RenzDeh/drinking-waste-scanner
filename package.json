{
  "name": "statiegeld-scanner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host --mode phone",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "negatives": "node scripts/fetch-negatives.mjs",
    "deploy": "vite build && node -e \"require('fs').copyFileSync('vercel.json','dist/vercel.json')\" && npx vercel@latest deploy dist --prod"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "inferencejs": "^1.3.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
