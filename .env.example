# --- Roboflow (inferencejs, draait IN de browser) ---
# Publishable key: Roboflow > Settings > API Keys > "Publishable API Key" (begint met rf_)
VITE_ROBOFLOW_PUBLISHABLE_KEY=rf_xxxxxxxxxxxxxxxxxxxx
# Project-slug (bv. "drinking-waste-abc12") OF volledige model-id ("workspace/model-slug")
VITE_ROBOFLOW_MODEL=drinking-waste-xxxxx
# Versienummer van het getrainde model. Laat LEEG als je een volledige model-id gebruikt.
VITE_ROBOFLOW_VERSION=1

